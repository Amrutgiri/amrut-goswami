<!-- ========================================
     MESSAGES INBOX PAGE
     Admin interface for viewing contact form messages
     Features: List, View Details, Delete Messages
     ======================================== -->

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Messages</h3>
        <p class="text-muted mb-0">View inquiries from the contact form</p>
    </div>
    <!-- Search / Filter (Visual Layout) -->
    <div class="d-flex gap-2">
        <select class="form-select w-auto" aria-label="Filter status">
            <option selected>All Messages</option>
            <option value="unread">Unread</option>
            <option value="read">Read</option>
        </select>
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" placeholder="Search messages...">
        </div>
    </div>
</div>

<!-- Messages Table Card -->
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%">#</th>
                        <th style="width: 20%">Sender Name</th>
                        <th style="width: 20%">Email</th>
                        <th style="width: 25%">Subject</th>
                        <th style="width: 15%">Received Date</th>
                        <th style="width: 10%">Status</th>
                        <th class="text-center" style="width: 5%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Demo Data: Unread Message -->
                    <tr class="fw-bold bg-light-subtle">
                        <td>1</td>
                        <td>John Doe</td>
                        <td>john.doe@example.com</td>
                        <td>Project Inquiry: E-commerce App</td>
                        <td>Jan 01, 2024</td>
                        <td><span class="badge bg-warning text-dark">Unread</span></td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                                    data-bs-target="#viewMessageModal" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                    data-bs-target="#deleteMessageModal" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <!-- Demo Data: Read Message -->
                    <tr>
                        <td>2</td>
                        <td>Jane Smith</td>
                        <td>jane.smith@design.com</td>
                        <td>Collaboration Proposal</td>
                        <td>Dec 28, 2023</td>
                        <td><span class="badge bg-success">Read</span></td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                                    data-bs-target="#viewMessageModal" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                    data-bs-target="#deleteMessageModal" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================
     VIEW MESSAGE MODAL
     ======================================== -->
<div class="modal fade" id="viewMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-envelope-open me-2"></i>Message Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold">From</label>
                    <div class="fs-5">John Doe <span
                            class="text-muted fs-6 fw-normal">&lt;john.doe@example.com&gt;</span></div>
                </div>
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold">Subject</label>
                    <div class="fw-semibold">Project Inquiry: E-commerce App</div>
                </div>
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold">Received</label>
                    <div>Jan 01, 2024 at 10:30 AM</div>
                </div>
                <hr>
                <div class="mb-3">
                    <label class="small text-muted text-uppercase fw-bold">Message</label>
                    <div class="p-3 bg-light rounded mt-1">
                        Hi, I found your portfolio online and I'm interested in hiring you to build a custom e-commerce
                        solution for my business. Please let me know your availability. Thanks!
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================
     DELETE MESSAGE MODAL
     ======================================== -->
<div class="modal fade" id="deleteMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-trash me-2"></i>Delete Message
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle text-danger display-1 mb-3"></i>
                <h5>Are you sure?</h5>
                <p class="text-muted mb-0">Do you really want to delete this message? This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger">Yes, Delete It</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================
     CDN LIBRARIES
     ======================================== -->

<!-- jQuery (Required for DataTables) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- SweetAlert2 CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.all.min.js"></script>

<!-- DataTables CSS & JS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

<!-- Messages Management Script -->
<script src="/js/messages.js"></script>