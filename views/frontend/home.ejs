<% const displayName = about && about.fullName ? about.fullName : "Your Name"; %>
<div class="portfolio-site">
    <header class="site-header">
        <a class="wordmark" href="#home" aria-label="Back to top"><%= displayName.split(" ").map(part => part[0]).slice(0, 2).join("").toUpperCase() %><span>.</span></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">
            <i class="bx bx-menu"></i>
        </button>
        <nav class="site-nav" aria-label="Main navigation">
            <a href="#about">About</a>
            <a href="#work">Work</a>
            <a href="#experience">Experience</a>
            <a href="#contact">Contact</a>
        </nav>
        <a class="header-cta" href="#contact">Let’s talk <i class="bx bx-up-arrow-alt"></i></a>
    </header>

    <main>
        <section class="hero section-wrap" id="home">
            <div class="hero-copy" data-reveal>
                <p class="eyebrow"><span class="availability-dot"></span> Portfolio / <%= about ? about.professionalTitle : "Creative portfolio" %></p>
                <h1>I’m <%= displayName %>.<br><span>I build for the web.</span></h1>
                <p class="hero-intro"><%= about ? about.professionalTitle : "Designer & Developer" %> creating useful, memorable experiences for the web.</p>
                <div class="hero-actions">
                    <a class="button button-dark" href="#work">Explore my work <i class="bx bx-right-arrow-alt"></i></a>
                    <% if (about && about.resume && about.resume.url) { %>
                        <a class="text-link" href="<%= about.resume.url %>" target="_blank" rel="noopener noreferrer">Download résumé <i class="bx bx-download"></i></a>
                    <% } %>
                </div>
                <div class="hero-meta">
                    <span><strong><%= projects ? projects.length : 0 %></strong> selected projects</span>
                    <span class="meta-divider"></span>
                    <span>Thoughtful work, built with care</span>
                </div>
            </div>
            <div class="hero-visual" data-reveal>
                <div class="portrait-frame">
                    <div class="portrait-topline"><span>PORTFOLIO / <%= new Date().getFullYear() %></span><i class="bx bx-arrow-from-bottom"></i></div>
                    <% if (about && about.profileImage && about.profileImage.url) { %>
                        <img class="portrait-image" src="<%= about.profileImage.url %>" alt="Portrait of <%= displayName %>">
                    <% } else { %>
                        <div class="portrait-placeholder" aria-label="<%= displayName %>"><%= displayName.split(" ").map(part => part[0]).slice(0, 2).join("").toUpperCase() %></div>
                    <% } %>
                    <div class="portrait-caption"><span>Good work starts with<br>a little curiosity.</span><span class="caption-mark">✳</span></div>
                </div>
                <div class="visual-index">01 <span>—</span> 04</div>
            </div>
            <a class="scroll-cue" href="#about"><span>Scroll to explore</span><i class="bx bx-down-arrow-alt"></i></a>
        </section>

        <section class="intro-section section-wrap" id="about" data-reveal>
            <% const aboutCopy = about && about.shortBio ? about.shortBio : "I bring ideas to life through clear thinking, thoughtful design, and well-crafted code."; const aboutParagraphs = aboutCopy.split(/\r?\n\s*\r?\n/).map(paragraph => paragraph.trim()).filter(Boolean); %>
            <div class="section-label"><span>01 / A little about me</span><span class="label-line"></span></div>
            <div class="intro-grid">
                <h2>Full-stack thinking.<br><span>From idea to launch.</span></h2>
                <div class="intro-copy">
                    <% aboutParagraphs.forEach(paragraph => { %>
                        <p><%= paragraph %></p>
                    <% }); %>
                    <div class="social-links">
                        <% if (about && about.socialLinks) { %>
                            <% if (about.socialLinks.linkedin) { %><a href="<%= about.socialLinks.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bx bxl-linkedin"></i></a><% } %>
                            <% if (about.socialLinks.github) { %><a href="<%= about.socialLinks.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="bx bxl-github"></i></a><% } %>
                            <% if (about.socialLinks.instagram) { %><a href="<%= about.socialLinks.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bx bxl-instagram"></i></a><% } %>
                            <% if (about.socialLinks.facebook) { %><a href="<%= about.socialLinks.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bx bxl-facebook"></i></a><% } %>
                            <% if (about.socialLinks.youtube) { %><a href="<%= about.socialLinks.youtube %>" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="bx bxl-youtube"></i></a><% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>

        <section class="work-section section-wrap" id="work">
            <div class="section-heading" data-reveal>
                <div><div class="section-label"><span>02 / Selected work</span><span class="label-line"></span></div><h2>Made with purpose<span>.</span></h2></div>
                <span class="section-count"><%= projects ? String(projects.length).padStart(2, "0") : "00" %> projects</span>
            </div>
            <% if (projects && projects.length > 0) { %>
                <div class="project-grid">
                    <% projects.forEach((project, index) => { %>
                        <article class="project-card" data-reveal>
                            <a class="project-image" href="<%= project.liveUrl || project.githubUrl || '#contact' %>" <% if (project.liveUrl || project.githubUrl) { %>target="_blank" rel="noopener noreferrer"<% } %> aria-label="View <%= project.title %>">
                                <% if (project.image && project.image.url) { %>
                                    <img src="<%= project.image.url %>" alt="<%= project.title %> project preview" loading="lazy">
                                <% } else { %>
                                    <span class="project-placeholder"><%= String(index + 1).padStart(2, "0") %></span>
                                <% } %>
                                <span class="project-arrow"><i class="bx bx-up-right-arrow-alt"></i></span>
                            </a>
                            <div class="project-info">
                                <div><span class="project-number">0<%= index + 1 %></span><h3><%= project.title %></h3></div>
                                <p><%= project.description %></p>
                                <div class="project-bottom">
                                    <div class="tag-list"><% (project.techStack || []).forEach(tech => { %><span><%= tech %></span><% }); %></div>
                                    <div class="project-links">
                                        <% if (project.githubUrl) { %><a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer" aria-label="<%= project.title %> source code"><i class="bx bxl-github"></i></a><% } %>
                                        <% if (project.liveUrl) { %><a href="<%= project.liveUrl %>" target="_blank" rel="noopener noreferrer" aria-label="<%= project.title %> live website"><i class="bx bx-link-external"></i></a><% } %>
                                    </div>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %><p class="empty-state">New work is on its way.</p><% } %>
        </section>

        <section class="expertise-section section-wrap" id="expertise">
            <div class="section-label" data-reveal><span>03 / What I bring</span><span class="label-line"></span></div>
            <div class="expertise-grid">
                <div class="services-column" data-reveal>
                    <h2>Good ideas,<br><span>made real.</span></h2>
                    <p class="muted-copy">A considered mix of strategy, craft, and technology to move your next project forward.</p>
                    <div class="service-list">
                        <% if (services && services.length > 0) { %>
                            <% services.forEach((service, index) => { %>
                                <div class="service-row"><span class="service-index">0<%= index + 1 %></span><h3><%= service.title %></h3><% if (service.icon) { %><i class="<%= service.icon %> service-icon"></i><% } %></div>
                            <% }); %>
                        <% } else { %><div class="service-row"><span class="service-index">01</span><h3>Thoughtful digital experiences</h3></div><% } %>
                    </div>
                </div>
                <div class="skills-column" data-reveal>
                    <div class="skills-heading"><span>Tools of the trade</span><i class="bx bx-shape-circle"></i></div>
                    <% const toolkitGroups = [
                        { title: "Frontend", items: ["React", "Next.js", "Vue.js", "Tailwind CSS", "Bootstrap", "Responsive UI"] },
                        { title: "Backend", items: ["Node.js", "Express", "Laravel", "PHP", "REST APIs", "Authentication & authorization"] },
                        { title: "Databases", items: ["MongoDB", "MySQL / MariaDB", "PostgreSQL", "SQL Server"] },
                        { title: "Development & integration", items: ["Git", "GitHub", "GitLab", "Docker", "API integration", "Debugging"] },
                        { title: "Deployment", items: ["Vercel", "Cloud & server deployment", "Environment configuration"] },
                        { title: "Architecture & quality", items: ["Scalable application architecture", "Database design", "Clean, reusable code", "Performance", "Security", "Maintainability", "Usability"] },
                        { title: "AI-assisted development", items: ["AI tools & agents", "Prompt-driven development", "AI API integration"] },
                        { title: "End-to-end ownership", items: ["Requirements", "Design", "Development", "Testing", "Deployment"] }
                    ];
                    const skillCategoryTitles = { frontend: "Frontend", backend: "Backend", database: "Databases", tools: "Development & integration", deployment: "Deployment", architecture: "Architecture & quality" };
                    (skills || []).forEach(skill => {
                        const category = (skill.category || "Other").toLowerCase();
                        const title = skillCategoryTitles[category] || (category.charAt(0).toUpperCase() + category.slice(1));
                        let group = toolkitGroups.find(item => item.title.toLowerCase() === title.toLowerCase());
                        if (!group) {
                            group = { title, items: [] };
                            toolkitGroups.push(group);
                        }
                        const exists = group.items.some(item => (typeof item === "string" ? item : item.name).toLowerCase() === skill.name.toLowerCase());
                        if (!exists) group.items.push({ name: skill.name, icon: skill.icon });
                    }); %>
                    <div class="toolkit-grid">
                        <% toolkitGroups.forEach(group => { %>
                            <div class="skill-group">
                                <h3><%= group.title %></h3>
                                <div class="skill-tags">
                                    <% group.items.forEach(item => { const skillName = typeof item === "string" ? item : item.name; const skillIcon = typeof item === "string" ? "" : item.icon; %>
                                        <span><% if (skillIcon) { %><i class="<%= skillIcon %>"></i><% } %><%= skillName %></span>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </section>

        <section class="journey-section section-wrap" id="experience">
            <div class="section-heading" data-reveal>
                <div><div class="section-label"><span>04 / The journey</span><span class="label-line"></span></div><h2>Experience & learning<span>.</span></h2></div>
            </div>
            <div class="journey-grid">
                <div class="timeline-column" data-reveal>
                    <h3 class="column-title">Experience</h3>
                    <% if (experiences && experiences.length > 0) { %>
                        <% experiences.forEach(exp => { %>
                            <article class="timeline-item"><span class="timeline-date"><%= new Date(exp.startDate).getFullYear() %> — <%= exp.isCurrent ? "Present" : (exp.endDate ? new Date(exp.endDate).getFullYear() : "") %></span><div><h4><%= exp.role %></h4><p class="timeline-place"><%= exp.companyName %></p><p><%= exp.description %></p></div></article>
                        <% }); %>
                    <% } else { %><p class="empty-state">Experience details coming soon.</p><% } %>
                </div>
                <div class="timeline-column education-column" data-reveal>
                    <h3 class="column-title">Education</h3>
                    <% if (education && education.length > 0) { %>
                        <% education.forEach(edu => { %>
                            <article class="timeline-item"><span class="timeline-date"><%= edu.startYear %> — <%= edu.isCurrent ? "Present" : edu.endYear %></span><div><h4><%= edu.degree %></h4><p class="timeline-place"><%= edu.institution %></p><% if (edu.description) { %><p><%= edu.description %></p><% } %></div></article>
                        <% }); %>
                    <% } else { %><p class="empty-state">Education details coming soon.</p><% } %>
                </div>
            </div>
        </section>

        <section class="contact-section" id="contact">
            <div class="contact-inner section-wrap">
                <div class="contact-copy" data-reveal>
                    <div class="section-label section-label-light"><span>05 / Start a conversation</span><span class="label-line"></span></div>
                    <h2>Have a good one<br>in mind<span>?</span></h2>
                    <p>Tell me a little about what you’re working on. I’ll get back to you soon.</p>
                    <p class="contact-prompt">Use the form to share a project, ask a question, or just say hello.</p>
                </div>
                <div class="contact-form-wrap" data-reveal>
                    <form id="contactForm">
                        <div class="form-row"><label for="contact-name">Your name</label><input id="contact-name" type="text" name="name" placeholder="Name" required></div>
                        <div class="form-row"><label for="contact-email">Email address</label><input id="contact-email" type="email" name="email" placeholder="you@example.com" required></div>
                        <div class="form-row"><label for="contact-subject">What’s this about?</label><input id="contact-subject" type="text" name="subject" placeholder="Project, question, or just hello" required></div>
                        <div class="form-row"><label for="msgContent">A few details</label><textarea name="message" id="msgContent" rows="3" placeholder="Tell me a little about it..." required></textarea></div>
                        <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
                        <button type="submit" class="button button-lime" id="sendBtn">Send your message <i class="bx bx-right-arrow-alt"></i></button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer"><a class="wordmark" href="#home"><%= displayName.split(" ").map(part => part[0]).slice(0, 2).join("").toUpperCase() %><span>.</span></a><p>© <%= new Date().getFullYear() %> <%= displayName %>. Made with care.</p><a href="#home">Back to top <i class="bx bx-up-arrow-alt"></i></a></footer>
</div>