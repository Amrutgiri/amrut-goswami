<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">About Section</h3>
        <p class="text-muted mb-0">Manage your personal profile information</p>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column - Edit Form -->
    <div class="col-lg-8">
        <div class="section-card">
            <h4 class="section-header">
                <i class="bi bi-person-circle me-2"></i>Profile Information
            </h4>

            <form action="/admin/about" method="POST" enctype="multipart/form-data">
                <!-- Full Name -->
                <div class="mb-4">
                    <label for="fullName" class="form-label">
                        <i class="bi bi-person-fill me-2"></i>Full Name
                        <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" id="fullName" name="fullName"
                        placeholder="Enter your full name" value="<%= about ? about.fullName : '' %>" required>
                </div>

                <!-- Professional Title -->
                <div class="mb-4">
                    <label for="professionalTitle" class="form-label">
                        <i class="bi bi-briefcase-fill me-2"></i>Professional Title
                        <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" id="professionalTitle" name="professionalTitle"
                        placeholder="Web Developer, Full Stack Developer, etc."
                        value="<%= about ? about.professionalTitle : '' %>" required>
                </div>

                <!-- Short Bio -->
                <div class="mb-4">
                    <label for="shortBio" class="form-label">
                        <i class="bi bi-text-paragraph me-2"></i>Short Bio
                        <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" id="shortBio" name="shortBio" rows="5"
                        placeholder="Write a short introduction about yourself"
                        required><%= about ? about.shortBio : '' %></textarea>
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        This will be displayed on your portfolio homepage
                    </div>
                </div>

                <!-- Profile Image Upload -->
                <div class="mb-4">
                    <label for="profileImage" class="form-label">
                        <i class="bi bi-image-fill me-2"></i>Profile Image
                    </label>
                    <input class="form-control" type="file" id="profileImage" name="profileImage"
                        accept="image/jpeg,image/png,image/jpg,image/webp">
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Accepted formats: JPG, PNG, WEBP (Max 5MB)
                    </div>

                    <!-- Image Preview -->
                    <% if (about && about.profileImage) { %>
                        <div class="mt-3">
                            <label class="form-label text-muted small">Current Image:</label>
                            <div class="image-preview-box">
                                <img src="<%= about.profileImage.url %>" alt="Profile Image" class="preview-image"
                                    id="currentProfileImage">
                            </div>
                        </div>
                        <% } else { %>
                            <div class="mt-3">
                                <div class="image-preview-placeholder">
                                    <i class="bi bi-person-circle"></i>
                                    <p class="mb-0 mt-2">No image uploaded</p>
                                </div>
                            </div>
                            <% } %>
                </div>

                <!-- Resume Upload -->
                <div class="mb-4">
                    <label for="resume" class="form-label">
                        <i class="bi bi-file-earmark-pdf-fill me-2"></i>Resume / CV
                    </label>
                    <input class="form-control" type="file" id="resume" name="resume" accept="application/pdf">
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Accepted format: PDF only (Max 10MB)
                    </div>

                    <!-- Resume File Info -->
                    <% if (about && about.resume) { %>
                        <div class="mt-3">
                            <div class="file-info-box">
                                <div class="d-flex align-items-center">
                                    <div class="file-icon">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="mb-0 fw-semibold">Current Resume</p>
                                        <small class="text-muted">
                                            <a href="<%= about.resume.url %>" target="_blank"
                                                class="text-decoration-none">
                                                <i class="bi bi-download me-1"></i>Download Resume
                                            </a>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } else { %>
                            <div class="mt-3">
                                <div class="file-placeholder">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                    <p class="mb-0 mt-2">No resume uploaded</p>
                                </div>
                            </div>
                            <% } %>
                </div>

                <!-- Social Profiles -->
                <div class="mb-4">
                    <label class="form-label">
                        <i class="bi bi-share-fill me-2"></i>Social Profiles
                    </label>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-facebook"></i></span>
                                <input type="text" class="form-control" name="facebook" placeholder="Facebook URL"
                                    value="<%= about && about.socialLinks ? about.socialLinks.facebook : '' %>">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-instagram"></i></span>
                                <input type="text" class="form-control" name="instagram" placeholder="Instagram URL"
                                    value="<%= about && about.socialLinks ? about.socialLinks.instagram : '' %>">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-linkedin"></i></span>
                                <input type="text" class="form-control" name="linkedin" placeholder="LinkedIn URL"
                                    value="<%= about && about.socialLinks ? about.socialLinks.linkedin : '' %>">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-youtube"></i></span>
                                <input type="text" class="form-control" name="youtube" placeholder="YouTube URL"
                                    value="<%= about && about.socialLinks ? about.socialLinks.youtube : '' %>">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                    <button type="reset" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reset
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column - Current Profile Preview -->
    <div class="col-lg-4">
        <div class="section-card">
            <h4 class="section-header">
                <i class="bi bi-eye-fill me-2"></i>Profile Preview
            </h4>

            <% if (about) { %>
                <div class="profile-preview">
                    <!-- Profile Image -->
                    <div class="text-center mb-3">
                        <% if (about.profileImage) { %>
                            <img src="<%= about.profileImage.url %>" alt="<%= about.fullName %>"
                                class="profile-preview-img">
                            <% } else { %>
                                <div class="profile-preview-placeholder">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <% } %>
                    </div>

                    <!-- Profile Info -->
                    <div class="text-center">
                        <h5 class="mb-1">
                            <%= about.fullName %>
                        </h5>
                        <p class="text-primary mb-3">
                            <%= about.professionalTitle %>
                        </p>
                        <p class="text-muted small mb-3">
                            <%= about.shortBio %>
                        </p>

                        <% if (about.resume) { %>
                            <a href="<%= about.resume.url %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-download me-1"></i>Download Resume
                            </a>
                            <% } %>
                    </div>
                </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-info-circle text-muted" style="font-size: 48px;"></i>
                        <p class="text-muted mt-3 mb-0">No profile data yet</p>
                        <small class="text-muted">Fill out the form to create your profile</small>
                    </div>
                    <% } %>
        </div>
    </div>
</div>